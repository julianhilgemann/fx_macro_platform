# Copy to .env (gitignored) and fill in. Nothing here is committed.

# --- FRED / ALFRED ---------------------------------------------------------
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Fetch mode:
#   synthetic -> deterministic FRED-shaped data, no key needed (default when no key)
#   fred      -> hit the real FRED API (requires FRED_API_KEY)
FX_FETCH_MODE=synthetic
# FX_HISTORY_START=2024-01-01

# --- Optional path overrides ----------------------------------------------
# RAW_DIR=./raw

# --- Postgres (spec §4) ----------------------------------------------------
# Host-side defaults (the Compose postgres publishes on 5433; inside the compose
# network it is `postgres:5432` and the services get that via docker-compose.yml).
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=warehouse
# POSTGRES_PORT=5433                     # host port (5433 avoids a clash with a host-local Postgres on 5432)
# PLATFORM_WRITER_USER=platform_writer   # Dagster/dbt role
# PLATFORM_WRITER_PASSWORD=writer_dev
# PLATFORM_READER_USER=platform_reader   # API/Metabase role
# PLATFORM_READER_PASSWORD=reader_dev

# --- Dagster (spec §14) -----------------------------------------------------
# Dagster run/event/schedule storage lives in this DB (created by sql/001_init.sh).
# DAGSTER_POSTGRES_DB=dagster

# --- Metabase (spec §11) ----------------------------------------------------
# Metabase stores its own app metadata on an embedded H2 in the metabase_data
# volume; it needs no DB env vars. Add the warehouse in the UI:
#   PostgreSQL  host=postgres  port=5432  db=warehouse
#   user=platform_reader  password=reader_dev
