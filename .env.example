# Copy to .env (gitignored) and fill in. Nothing here is committed.

# --- FRED / ALFRED ---------------------------------------------------------
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY= 

# Fetch mode:
#   synthetic -> deterministic FRED-shaped data, no key needed (default when no key)
#   fred      -> hit the real FRED API (requires FRED_API_KEY)
FX_FETCH_MODE=synthetic

# --- Optional path/behaviour overrides ------------------------------------
# Defaults derive from the repo root; uncomment to override.
# DUCKDB_PATH=./warehouse/fx_macro.duckdb
# RAW_DIR=./raw
# FX_HISTORY_START=2024-01-01

# --- Postgres (M0 warehouse, spec §4) -------------------------------------
# docker compose reads these for the postgres service. Inline defaults in
# docker-compose.yml keep `make up` zero-config; override here for real values.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=warehouse
# POSTGRES_PORT=5433    # host port (5433 avoids a clash with a host-local Postgres on 5432)
# PLATFORM_WRITER_PASSWORD=writer_dev    # Dagster/dbt role
# PLATFORM_READER_PASSWORD=reader_dev    # API/Metabase role
