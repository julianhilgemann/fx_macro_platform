# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Secrets — never commit
.env

# Immutable raw store & warehouse are data, not code (kept as empty dirs)
raw/*
!raw/.gitkeep
warehouse/*
!warehouse/.gitkeep

# dbt build artifacts + local state
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# OS
.DS_Store
