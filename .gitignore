# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Secrets — never commit
.env

# Immutable raw store & warehouse are data, not code (kept as empty dirs)
raw/*
!raw/.gitkeep
warehouse/*
!warehouse/.gitkeep

# dbt build artifacts + local state
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# OS
.DS_Store

# DeepSeek Harness runtime cache (created in cwd by the agent runtime)
.dsh-cache/
.dsh-pnpm/
.dsh-tooling/

# Dagster local instance (run/event storage)
.dagster_home/

# Generated reports (Elementary edr output)
reports/

# Elementary edr CLI logs/intermediates
edr_target/

# Raw research scratch (fetched source documents, intermediate extracts).
# Keep the distilled deliverables in docs/research/; ignore this cache.
docs/research/sourcing/scratch/
docs/research/tax-deep-dives/jp_tax_research/

# Research: keep the distilled markdown deliverables, ignore the raw fetch cache
# (downloaded PDFs/HTML/XLSX source documents - reproducible, ~70 MB).
docs/research/**/*.pdf
docs/research/**/*.html
docs/research/**/*.txt
docs/research/**/*.xlsx
