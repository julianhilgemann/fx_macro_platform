{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.14\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\nselect\n      'warehouse' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'elementary'\n    union all\n    select\n      'warehouse' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'elementary'\n    union all\n    select\n      'warehouse' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'elementary'\n    union all\n    select distinct\n     'warehouse' as database,\n     proname as name,\n     ns.nspname as schema,\n     'function' as type\n    from pg_proc\n     join pg_namespace as ns on pronamespace = ns.oid\n    where ns.nspname ilike 'elementary'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "aa74b8f7-a845-4758-a5cc-48c3a9cb5193", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.14\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\nselect\n      'warehouse' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'elementary'\n    union all\n    select\n      'warehouse' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'elementary'\n    union all\n    select\n      'warehouse' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'elementary'\n    union all\n    select distinct\n     'warehouse' as database,\n     proname as name,\n     ns.nspname as schema,\n     'function' as type\n    from pg_proc\n     join pg_namespace as ns on pronamespace = ns.oid\n    where ns.nspname ilike 'elementary'\n  ", "name": "SQLQuery", "pid": 30066, "thread": "MainThread", "ts": "2026-09-05T10:58:14.577037Z"}}
