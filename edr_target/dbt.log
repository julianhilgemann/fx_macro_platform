": 0.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-05 10:45:57\"}, {\"unique_id\": \"model.fx_macro.stg_fred__observations\", \"invocation_id\": \"ca83c48c-cf37-4ab8-9c91-73f4e587a47d\", \"name\": \"stg_fred__observations\", \"schema\": \"staging\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-05 10:45:57\"}, {\"unique_id\": \"model.fx_macro.fct_macro_observation_latest\", \"invocation_id\": \"ca83c48c-cf37-4ab8-9c91-73f4e587a47d\", \"name\": \"fct_macro_observation_latest\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.9, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": null, \"generated_at\": \"2026-09-05 10:45:57\"}, {\"unique_id\": \"model.fx_macro.int_macro__observations_unioned\", \"invocation_id\": \"ca83c48c-cf37-4ab8-9c91-73f4e587a47d\", \"name\": \"int_macro__observations_unioned\", \"schema\": \"intermediate\", \"status\": \"success\", \"execution_time\": 0.0, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-05 10:45:57\"}, {\"unique_id\": \"model.fx_macro.stg_bundesbank__observations\", \"invocation_id\": \"ca83c48c-cf37-4ab8-9c91-73f4e587a47d\", \"name\": \"stg_bundesbank__observations\", \"schema\": \"staging\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": null, \"generated_at\": \"2026-09-05 10:45:57\"}, {\"unique_id\": \"model.fx_macro.stg_bundesbank__observations\", \"invocation_id\": \"fcfd9c4b-ddf7-42e8-b757-a11018850f9f\", \"name\": \"stg_bundesbank__observations\", \"schema\": \"staging\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Staging: parse the Bundesbank BBSSY fetch payload (normalized jsonb).\\n-- Bundesbank exposes no vintage; known_at = fetched_at::date.\\nwith src as (\\n    select\\n        resource as series_id,\\n        fetched_at,\\n        payload -> 'observations' as obs\\n    from \\\"warehouse\\\".\\\"raw\\\".\\\"source_fetch\\\"\\n    where source = 'bundesbank'\\n      and payload is not null\\n),\\n\\nflat as (\\n    select\\n        series_id,\\n        fetched_at,\\n        jsonb_array_elements(obs) as o\\n    from src\\n)\\n\\nselect\\n    series_id,\\n    (o ->> 'date')::date as obs_date,\\n    case\\n        when o ->> 'value' is null or o ->> 'value' = '.' then null\\n        else (o ->> 'value')::numeric\\n    end as value,\\n    fetched_at::date as known_at,\\n    fetched_at\\nfrom flat\\nwhere o ->> 'date' is not null\", \"generated_at\": \"2026-09-05 10:47:01\"}, {\"unique_id\": \"model.fx_macro.int_macro__observations_unioned\", \"invocation_id\": \"fcfd9c4b-ddf7-42e8-b757-a11018850f9f\", \"name\": \"int_macro__observations_unioned\", \"schema\": \"intermediate\", \"status\": \"success\", \"execution_time\": 0.0, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Union the three source stagings and resolve to a unique bitemporal grain\\n-- (series_id, obs_date, known_at). is_latest marks the newest known value per\\n-- (series_id, obs_date). Missing values are dropped (the fact has no nulls).\\nwith unioned as (\\n    select * from \\\"warehouse\\\".\\\"staging\\\".\\\"stg_fred__observations\\\"\\n    union all\\n    select * from \\\"warehouse\\\".\\\"staging\\\".\\\"stg_ecb__observations\\\"\\n    union all\\n    select * from \\\"warehouse\\\".\\\"staging\\\".\\\"stg_bundesbank__observations\\\"\\n),\\n\\ndeduped as (\\n    select\\n        series_id,\\n        obs_date,\\n        known_at,\\n        value,\\n        fetched_at,\\n        row_number() over (\\n            partition by series_id, obs_date, known_at\\n            order by fetched_at desc\\n        ) as rn\\n    from unioned\\n    where value is not null\\n)\\n\\nselect\\n    series_id,\\n    obs_date,\\n    known_at,\\n    value,\\n    fetched_at,\\n    row_number() over (\\n        partition by series_id, obs_date\\n        order by known_at desc, fetched_at desc\\n    ) = 1 as is_latest\\nfrom deduped\\nwhere rn = 1\", \"generated_at\": \"2026-09-05 10:47:01\"}, {\"unique_id\": \"model.fx_macro.stg_ecb__observations\", \"invocation_id\": \"fcfd9c4b-ddf7-42e8-b757-a11018850f9f\", \"name\": \"stg_ecb__observations\", \"schema\": \"staging\", \"status\": \"success\", \"execution_time\": 0.1, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Staging: parse the ECB SDW fetch payload (normalized jsonb) into observations.\\n-- ECB exposes no vintage; known_at = fetched_at::date (approximate revision history).\\nwith src as (\\n    select\\n        resource as series_id,\\n        fetched_at,\\n        payload -> 'observations' as obs\\n    from \\\"warehouse\\\".\\\"raw\\\".\\\"source_fetch\\\"\\n    where source = 'ecb'\\n      and payload is not null\\n),\\n\\nflat as (\\n    select\\n        series_id,\\n        fetched_at,\\n        jsonb_array_elements(obs) as o\\n    from src\\n)\\n\\nselect\\n    series_id,\\n    (o ->> 'date')::date as obs_date,\\n    case\\n        when o ->> 'value' is null or o ->> 'value' = '.' then null\\n        else (o ->> 'value')::numeric\\n    end as value,\\n    fetched_at::date as known_at,\\n    fetched_at\\nfrom flat\\nwhere o ->> 'date' is not null\", \"generated_at\": \"2026-09-05 10:47:01\"}, {\"unique_id\": \"model.fx_macro.fct_macro_observation\", \"invocation_id\": \"fcfd9c4b-ddf7-42e8-b757-a11018850f9f\", \"name\": \"fct_macro_observation\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 1.1, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"-- Bitemporal fact (spec \\u00a76): grain (series_id, obs_date, known_at).\\nselect\\n    md5(concat_ws('|', series_id, cast(obs_date as varchar), cast(known_at as varchar))) as observation_key,\\n    series_id,\\n    obs_date,\\n    known_at,\\n    value,\\n    is_latest\\nfrom \\\"warehouse\\\".\\\"intermediate\\\".\\\"int_macro__observations_unioned\\\"\", \"generated_at\": \"2026-09-05 10:47:01\"}, {\"unique_id\": \"model.fx_macro.fct_macro_observation_latest\", \"invocation_id\": \"fcfd9c4b-ddf7-42e8-b757-a11018850f9f\", \"name\": \"fct_macro_observation_latest\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 1.1, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"-- Latest view (spec \\u00a76): one row per (series_id, obs_date), newest known value.\\nselect\\n    md5(concat_ws('|', series_id, cast(obs_date as varchar))) as series_obs_key,\\n    series_id,\\n    obs_date,\\n    known_at,\\n    value\\nfrom \\\"warehouse\\\".\\\"intermediate\\\".\\\"int_macro__observations_unioned\\\"\\nwhere is_latest\", \"generated_at\": \"2026-09-05 10:47:01\"}, {\"unique_id\": \"model.fx_macro.stg_fred__observations\", \"invocation_id\": \"fcfd9c4b-ddf7-42e8-b757-a11018850f9f\", \"name\": \"stg_fred__observations\", \"schema\": \"staging\", \"status\": \"success\", \"execution_time\": 0.1, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"-- Staging: parse the FRED fetch payload (jsonb) into typed observations.\\n-- known_at = the observation's realtime_start (release/vintage date);\\n-- fetched_at = provenance (when we pulled it).\\nwith src as (\\n    select\\n        resource as series_id,\\n        fetched_at,\\n        payload -> 'observations' as obs\\n    from \\\"warehouse\\\".\\\"raw\\\".\\\"source_fetch\\\"\\n    where source = 'fred'\\n      and payload is not null\\n),\\n\\nflat as (\\n    select\\n        series_id,\\n        fetched_at,\\n        jsonb_array_elements(obs) as o\\n    from src\\n)\\n\\nselect\\n    series_id,\\n    (o ->> 'date')::date as obs_date,\\n    case\\n        when o ->> 'value' is null or o ->> 'value' = '.' then null\\n        else (o ->> 'value')::numeric\\n    end as value,\\n    coalesce((o ->> 'realtime_start')::date, fetched_at::date) as known_at,\\n    fetched_at\\nfrom flat\\nwhere o ->> 'date' is not null\", \"generated_at\": \"2026-09-05 10:47:01\"}, {\"unique_id\": \"model.fx_macro.dim_series\", \"invocation_id\": \"fcfd9c4b-ddf7-42e8-b757-a11018850f9f\", \"name\": \"dim_series\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.1, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"-- Series catalog dimension (spec \\u00a77). Served by the API/BI alongside the facts.\\nselect * from \\\"warehouse\\\".\\\"meta\\\".\\\"series_catalog\\\"\", \"generated_at\": \"2026-09-05 10:47:01\"}]--ELEMENTARY-MACRO-OUTPUT-END--", "name": "JinjaLogInfo", "pid": 30066, "thread": "MainThread", "ts": "2026-09-05T10:58:20.639937Z"}}
